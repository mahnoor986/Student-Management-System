# Copy this file to backend/.env and fill in real values. Never commit .env.

# Long random string; keeps users signed in across server restarts.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# true only when the site is served over HTTPS (marks session/CSRF cookies Secure). Keep false for local http.
DJANGO_SECURE_COOKIES=false

# Supabase: Project -> Connect -> "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password.
# Leave empty (or delete the line) to use the local SQLite file instead.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
